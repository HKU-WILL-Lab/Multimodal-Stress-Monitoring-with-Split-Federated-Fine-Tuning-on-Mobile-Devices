+/**
+ * @brief Resource ownership and execution bounds for a Gemma decoder span.
+ *
+ * Layers are represented as the half-open interval
+ * [first_layer, past_last_layer). A negative past_last_layer selects every
+ * layer through config.num_hidden_layers. The default preserves the historical
+ * full causal-LM behavior.
+ */
+struct GemmaHiddenSpanConfig {
+    int first_layer = 0;
+    int past_last_layer = -1;
+    bool include_token_embedding = true;
+    bool include_output_projection = true;
+
+    static GemmaHiddenSpanConfig prefix(int past_last_layer) {
+        GemmaHiddenSpanConfig span;
+        span.past_last_layer = past_last_layer;
+        span.include_output_projection = false;
+        return span;
+    }
+};
